{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      "**/.*",
      "**/node_modules/**",
      "public/**",
      "serve.js",
      "start.bat",
      "deploy.bat",
      "README.md",
      "WhatsApp*"
    ],
    "headers": [
      {
        "source": "assets/video/**",
        "headers": [
          { "key": "Accept-Ranges", "value": "bytes" },
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "assets/images/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
